# NURU configuration. Copy to .env and fill in. Never commit .env.

# --- LLM provider: none | openai | anthropic | gemini -------------------------
# "none" (default) runs fully offline and replies with the best library answer.
NURU_LLM_PROVIDER=none
# Optional model override (defaults: gpt-4o-mini, claude-haiku-5-5, gemini-2.5-flash)
NURU_LLM_MODEL=
NURU_LLM_TIMEOUT=15
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Africa's Talking -------------------------------------------------------
# Use "sandbox" with your sandbox API key for testing (no real SMS are sent).
AT_USERNAME=sandbox
AT_API_KEY=
# Your two-way / toll-free shortcode (or sandbox shortcode)
AT_SHORTCODE=
# true = never call the SMS API, just log (default). Set false to send.
NURU_SMS_DRY_RUN=true

# --- Service ----------------------------------------------------------------
# Optional shared secret; if set, callbacks must use ?token=<value>
NURU_WEBHOOK_TOKEN=
# Salt for hashing phone numbers in logs. Use a long random value in production.
NURU_PHONE_HASH_SALT=change-me
# Max reply length in GSM-7 characters (306 = 2 concatenated SMS)
NURU_MAX_REPLY_CHARS=306
NURU_MIN_RETRIEVAL_SCORE=0.12
# Replace with the official MoH HFR export before any pilot
NURU_FACILITIES_CSV=data/facilities_sample.csv
NURU_CONTENT_DIR=content
